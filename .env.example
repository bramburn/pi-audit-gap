# --- Spec lane: sparse, high-level auditor (Claude Opus via Anthropic) ---
# Falls back to VERIFIER_BASE_URL / VERIFIER_API_KEY / VERIFIER_MODEL when unset.

# Transport: "anthropic" (native /v1/messages — REQUIRED for batch mode)
# or "openai" (OpenAI-compatible: OpenRouter, LiteLLM, pi-harvest verifier...).
AUDITGAP_SPEC_API=anthropic

# Set to 1 to route spec-lane work through the Anthropic Messages Batches
# API (50% discount, minutes-to-hours latency). Jobs are spooled durably
# under .pi/audit-gap/queue/ and polled every AUDITGAP_BATCH_POLL_EVERY_TURNS
# turns (min AUDITGAP_BATCH_POLL_MIN_SECS apart). Manual /auditgap commands
# always use the direct lane.
AUDITGAP_SPEC_BATCH=1

AUDITGAP_SPEC_BASE_URL=https://api.anthropic.com/v1
AUDITGAP_SPEC_API_KEY=sk-ant-...
AUDITGAP_SPEC_MODEL=claude-opus-5-5
AUDITGAP_SPEC_PROVIDER=OPUS
AUDITGAP_SPEC_MAX_TOKENS=8192

# --- Cover lane: cheap, high-volume verifier ---
# ALWAYS OpenAI-compatible chat/completions. Use DeepSeek directly:
#   AUDITGAP_COVER_BASE_URL=https://api.deepseek.com/v1
# or spend OpenRouter credits with any OpenRouter model id:
#   AUDITGAP_COVER_BASE_URL=https://openrouter.ai/api/v1
AUDITGAP_COVER_BASE_URL=https://openrouter.ai/api/v1
AUDITGAP_COVER_API_KEY=sk-or-...
AUDITGAP_COVER_MODEL=deepseek/deepseek-chat
AUDITGAP_COVER_PROVIDER=DS

# --- Batch monitor cadence ---
AUDITGAP_BATCH_POLL_EVERY_TURNS=5
AUDITGAP_BATCH_POLL_MIN_SECS=60

# --- Behavior ---
# Turns between coverage sweeps against pending dod.json items.
AUDITGAP_TURN_INTERVAL=30
# Max cover-lane LLM calls per sweep (budget guard).
AUDITGAP_COVER_MAX_CALLS=5
# Verified-item count stuck across this many sweeps => escalate to spec-lane gap audit.
AUDITGAP_PLATEAU_SWEEPS=2
# Per-attempt timeouts.
AUDITGAP_SPEC_TIMEOUT_MS=600000
AUDITGAP_COVER_TIMEOUT_MS=120000
AUDITGAP_MAX_RETRIES=2
